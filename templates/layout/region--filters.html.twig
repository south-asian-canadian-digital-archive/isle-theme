
{# {% if content %} #}
	<div{{ attributes.addClass('filters', 'result-facets', 'min-h-[10vh]') }}>
		<h4 class="filters-heading border-y border-b-[#e5e5e5] border-t-transparent m-0">
			<button type="button" class="filters-toggle" aria-expanded="true" aria-controls="filters-panel-content">
				<span class="flex items-center text-lg! h-10">Filter Results</span>
			</button>
		</h4>
		{% if clear_filters_url %}
			<a href="{{ clear_filters_url }}" class="filters-clear">{{ 'Clear all'|t }}</a>
		{% endif %}
		<div id="filters-panel-content" class="filters-content">
			{{ content }}
		</div>
	</div>
{# {% endif %} #}
