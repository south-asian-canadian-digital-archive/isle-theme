{# Taxonomy results use the same grid treatment and placeholders as search. #}
{% import '@sacda/macros/media_placeholder.twig' as ph %}
{% set model = node.hasField('field_model') and not node.field_model.isEmpty() ? node.field_model.entity.label : '' %}
<article{{ attributes.addClass('group', 'results-card') }}>
	{{ title_prefix }}{{ title_suffix }}
	<div class="results-card__image relative aspect-square bg-muted overflow-hidden [&_img]:w-full [&_img]:h-full [&_img]:object-cover">
		<a href="{{ url }}" tabindex="-1" aria-hidden="true" class="block w-full h-full">
			{% if taxonomy_card_image %}<img src="{{ taxonomy_card_image.url }}" alt="{{ taxonomy_card_image.alt }}" loading="lazy">{% else %}{{ ph.placeholder(model) }}{% endif %}
		</a>
	</div>
	<div class="results-card__info py-2.5">
		<h2 class="text-sm leading-tight mb-1"><a href="{{ url }}" class="group-hover:underline">{{ label }}</a></h2>
		{% if node.hasField('field_member_of') and not node.field_member_of.isEmpty() and node.field_member_of.entity %}
			<div class="text-xs text-muted-foreground">{{ node.field_member_of.entity.label }}</div>
		{% endif %}
	</div>
</article>
