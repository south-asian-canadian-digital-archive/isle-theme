{#
/**
 * @file
 * Theme override to display a node of type 'collection'.
 * Simple layout with title, description, and children content.
 */
#}

<article{{ attributes.addClass('node-collection') }}> {# py-8 #}
	<div class="max-w-5xl mx-auto">

		{{ title_prefix }}
		{{ title_suffix }}

		{% if content.body|render|striptags|trim %}
			<div class="prose max-w-none text-foreground leading-relaxed mb-8">
				{{ content.body }}
			</div>
		{% endif %}

		{# Remaining metadata fields sit inline and wrap as needed. #}
		<div class="flex flex-wrap gap-x-10 gap-y-2">
			{{ content|without('body', 'field_description', 'group_admin_only') }}
		</div>

		{# Description can be long, so give it the full width for readability. #}
		{% if content.field_description|render|striptags|trim %}
			<div class="mb-6">
				{{ content.field_description }}
			</div>
		{% endif %}

		{# Field groups (details accordions) render separately, full width, at the bottom. #}
		{% if content.group_admin_only %}
			<div class="mt-10">
				{{ content.group_admin_only }}
			</div>
		{% endif %}

	</div>
</article>
