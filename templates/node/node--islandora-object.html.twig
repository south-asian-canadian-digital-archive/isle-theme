{#
/**
 * @file
 * Theme override to display a node of type 'islandora_object' (Repository Item).
 * Single column layout.
 */
#}

{% import '@sacda/macros/button.twig' as btn %}

<div{{ attributes.addClass('py-8', 'node--type-islandora-object') }}>
    {{ title_prefix|without('a') }}
	{{ title_suffix }}

	{# Two-column flex layout: main content + sidebar #}
	<div class="flex flex-col lg:flex-row gap-8">

		{# Main content (left) - all fields except sidebar groups #}
		<div class="flex-1 min-w-0">
			{# <div class="bg-card p-6 border border-border"> #}
				{{ content|without('group_backlinks', 'group_location') }}
			<!--</div>-->
			{% if ocr_text %}
				<details class="item-transcript">
					<summary>{{ 'Transcript'|t }}</summary>
					<p class="item-transcript__note">{{ 'Generated automatically, so it may contain errors.'|t }}</p>
					<div class="item-transcript__text" tabindex="0">{{ ocr_text }}</div>
				</details>
			{% endif %}
		</div>

		{# Sidebar (right) - backlinks and location #}
		<aside class="w-full lg:w-80 lg:max-w-sm flex-shrink-0">
			<div class="flex flex-col gap-6">

				{% if content.group_backlinks %}
					{{ content.group_backlinks }}
				{% endif %}
                {% if item_downloads %}
                    <details class="sacda-downloads" open>
                        <summary>{{ 'Downloads'|t }}</summary>
                        <ul>
                        {% for file in item_downloads %}
                            <li><a href="{{ file.url }}" download="{{ file.name }}">
                                <span>{{ file.label }} <span aria-hidden="true">↓</span></span>
                                <small>{{ file.format }} · {{ file.size }}</small>
                            </a></li>
                        {% endfor %}
                        </ul>
                    </details>
                {% endif %}
				{% if content.group_location %}
					{{ content.group_location }}
				{% endif %}

			</div>
		</aside>

	</div>

</div>

{# {{ dump(content) }} #}
