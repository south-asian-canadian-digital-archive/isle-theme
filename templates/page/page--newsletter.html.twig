{% extends '@sacda/page/page.html.twig' %}

{# Adapted from old_stuff/views/Contribute/form_html.php. #}
{% block content %}
<main role="main" class="newsletter-page">
	<section class="newsletter__info">
		<div class="newsletter__info__img">
			<img src="{{ base_path ~ directory }}/static/graphics/contribute/SACDA_Hive.png" alt="The Hive — SACDA's newsletter">
		</div>
		<div class="newsletter__info__content">
			<form action="https://sacda.us4.list-manage.com/subscribe/post?u=3c616907ab5cf63924a62f942&amp;id=383fd0ae1e&amp;f_id=000f56e2f0" method="post" id="mc-embedded-subscribe-form" name="mc-embedded-subscribe-form" target="_blank" class="newsletter__signup__form">
				<p>We are thrilled to introduce The Hive, our newsletter! In each issue, The Hive will bring you stories from our archive 🗃️, updates on collaborations 🤝🏽, and insights into how we're preserving the rich and diverse histories of South Asian Canadian communities. Signup below!</p>
				<div class="newsletter__form">
					<label for="mce-EMAIL" class="sr-only">Email address</label>
					<input type="email" name="EMAIL" id="mce-EMAIL" required placeholder="your_email@example.com" autocomplete="email" class="newsletter__email">
					<div class="newsletter__honeypot" aria-hidden="true">
						<input type="text" name="b_3c616907ab5cf63924a62f942_383fd0ae1e" tabindex="-1" value="" autocomplete="off">
					</div>
					<button type="submit" name="subscribe" class="newsletter__submit">Subscribe</button>
				</div>
			</form>
		</div>
	</section>

	{# Preserve the node render array for contextual edit links. #}
	<div class="newsletter-body content">{{ page.content }}</div>

	<section class="newsletter-section" aria-label="Newsletter issues">
		<div class="newsletter-list-wrapper">
			<h2>Latest Issue</h2>
			<div class="newsletter-list newsletter-list--latest">
				{% if newsletter_issues|length %}
					{% include '@sacda/page/newsletter-card.html.twig' with { issue: newsletter_issues|first } only %}
				{% else %}
					<p>Newsletter issues are temporarily unavailable.</p>
				{% endif %}
			</div>
		</div>

		<div class="newsletter-list-wrapper">
			<h2>Past Issues</h2>
			<div class="newsletter-list">
				{% for issue in newsletter_issues|slice(1) %}
					{% include '@sacda/page/newsletter-card.html.twig' with { issue: issue } only %}
				{% else %}
					<a href="{{ newsletter_archive_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-default">View the newsletter archive</a>
				{% endfor %}
			</div>
		</div>
	</section>
</main>
{% endblock %}
