{#
  OpenSeadragon view mode. An animated GIF original is shown as itself (see
  includes/animated_gif.inc), since deep-zoom tiles are a still frame.
#}
{% if animated_gif_url %}
	<div class="media-gif">
		<img src="{{ animated_gif_url }}" alt="{{ animated_gif_alt }}">
	</div>
{% else %}
	<div{{ attributes }}>
		{{ title_suffix.contextual_links }}
		{{ content }}
	</div>
{% endif %}
