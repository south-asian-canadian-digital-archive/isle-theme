require_once __DIR__ . '/includes/footer.inc';
require_once __DIR__ . '/includes/carousel.inc';
require_once __DIR__ . '/includes/theme_settings.inc';
require_once __DIR__ . '/includes/theme_settings_callbacks.inc';
require_once __DIR__ . '/includes/suggestions.inc';
require_once __DIR__ . '/includes/team.inc';
require_once __DIR__ . '/includes/info_pages.inc';
require_once __DIR__ . '/includes/pdf_preview.inc';
require_once __DIR__ . '/includes/media_download.inc';
require_once __DIR__ . '/includes/animated_gif.inc';

/**
 * Implements hook_form_system_theme_settings_alter().
 */
function sacda_form_system_theme_settings_alter(array &$form, FormStateInterface $form_state): void {
  _sacda_build_theme_settings_form($form, $form_state);
}

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function sacda_preprocess_html(array &$variables): void {
  $is_dev = getenv('DRUPAL_ENV') === 'development' ||
            file_exists(DRUPAL_ROOT . '/sites/development.services.yml');

  if ($is_dev) {
    // $variables['page']['#attached']['html_head'][] = [
    //   [
    //     '#type' => 'html_tag',
    //     '#tag' => 'script',
    //     '#attributes' => ['src' => 'http://localhost:35729/livereload.js'],
    //   ],
    //   'livereload',
    // ];
  }

  $variables['page']['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'meta',
      '#attributes' => [
        'name' => 'viewport',
        'content' => 'width=device-width, initial-scale=1.0',
      ],
    ],
    'viewport',
  ];
}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 */
function sacda_preprocess_page(array &$variables): void {
  $theme_path = '/' . \Drupal::theme()->getActiveTheme()->getPath();

  $variables['site_name'] = \Drupal::config('system.site')->get('name');
  $variables['current_year'] = date('Y');
  $variables['theme_path'] = $theme_path;
  $variables['logo'] = $theme_path . '/logo.svg';
  $variables['is_front'] = \Drupal::service('path.matcher')->isFrontPage();

  _sacda_preprocess_footer_partners($variables, $theme_path);
  _sacda_preprocess_footer_social($variables);
  _sacda_add_color_variables($variables);
  _sacda_preprocess_carousel($variables, $theme_path);
  _sacda_preprocess_repository_carousel($variables);
  _sacda_preprocess_featured_exhibits($variables);
  _sacda_preprocess_featured_collections($variables);
  _sacda_preprocess_front_themes($variables);

  // Recreate the original newsletter's Mailchimp-driven issue cards without
  // exposing the private API key used by the retired Pawtucket theme.
  _sacda_preprocess_newsletter($variables, $theme_path);

  // Determine if filters sidebar has actual content.
  //
  // The region is rendered exactly once, here, and the template prints that
  // markup. Rendering a copy to test it and then letting the template render
  // the region again built every facet block twice; between the two builds the
  // search view runs and refills the cached facets with unprocessed results,
  // so the second (visible) render lost every facet link and checkbox.
  $show_filters = FALSE;
  if (!empty($variables['page']['filters'])) {
    $filters_build = $variables['page']['filters'];
    $rendered_filters = (string) \Drupal::service('renderer')->renderInIsolation($filters_build);
    $variables['page']['filters'] = [
      '#markup' => \Drupal\Core\Render\Markup::create($rendered_filters),
      '#attached' => $filters_build['#attached'] ?? [],
      '#cache' => $filters_build['#cache'] ?? [],
    ];

    // Remove block titles and summaries which often contain text/svgs even when the block content is empty.
    $rendered_no_titles = preg_replace('/<summary\b[^>]*>.*?<\/summary>/is', '', $rendered_filters);
    $rendered_no_titles = preg_replace('/<h[1-6]\b[^>]*>.*?<\/h[1-6]>/is', '', $rendered_no_titles);

    // Remove hidden inputs as they do not constitute visible content.
    $rendered_no_hidden = preg_replace('/<input\b[^>]*type=[\'"]hidden[\'"][^>]*>/is', '', $rendered_no_titles);

    // Remove any elements that are explicitly hidden by facets or utility classes.
    // This is a basic regex that removes the entire tag contents for tags with class="... hidden ..." or "... facet-hidden ...".
    // Note: Due to regex limitations on nested tags, this is a best-effort approach that works for typical facet structures.
    $rendered_no_hidden_classes = preg_replace('/<[^>]*class="[^"]*\b(hidden|facet-hidden)\b[^"]*"[^>]*>.*?<\/[^>]+>/is', '', $rendered_no_hidden);

    // Strip most HTML tags to just look for textual content or interactive elements
    $clean_filters = strip_tags($rendered_no_hidden_classes, '<img><input><select><textarea><button>');

    // Remove all whitespace
    $clean_filters = preg_replace('/\s+/', '', $clean_filters);

    if (!empty($clean_filters)) {
      $show_filters = TRUE;
    }
  }
  $variables['show_filters_sidebar'] = $show_filters;
}

/**
 * Builds the curated subject cards on the front page.
 */
function _sacda_preprocess_front_themes(array &$variables): void {
  if (!$variables['is_front']) {
    return;
  }
  $variables['front_themes'] = [];
  $variables['page']['#cache']['tags'][] = 'taxonomy_term_list';
  $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $nodes = \Drupal::entityTypeManager()->getStorage('node');
  $seen = [];
  for ($i = 1; $i <= 4; $i++) {
    $tid = theme_get_setting('front_theme_' . $i);
    if (!$tid || isset($seen[$tid]) || !($term = $terms->load($tid)) || $term->bundle() !== 'subject') {
      continue;
    }
    $access = $term->access('view', NULL, TRUE);
    \Drupal::service('renderer')->addCacheableDependency($variables['page'], $access);
    if (!$access->isAllowed()) {
      continue;
    }
    $seen[$tid] = TRUE;
    $variables['page']['#cache']['tags'] = array_merge($variables['page']['#cache']['tags'], $term->getCacheTags());
    $query = $nodes->getQuery()->accessCheck(TRUE)
      ->condition('type', 'islandora_object')->condition('status', 1);
    $subjects = $query->orConditionGroup()
      ->condition('field_subject', $tid)
      ->condition('field_sacda_thesaurus', $tid);
    $ids = $query->condition($subjects)->sort('created', 'DESC')->sort('nid', 'DESC')->execute();
    $image = NULL;
    foreach ($nodes->loadMultiple($ids) as $node) {
      if ($image = _sacda_front_page_image($node, $variables)) {
        break;
      }
    }
    $variables['front_themes'][] = [
      'title' => $term->label(),
      'link' => $term->toUrl()->toString(),
      'image' => $image['url'] ?? NULL,
      'image_alt' => $image['alt'] ?? '',
    ];
  }
}

/**
 * Supplies promoted collection nodes to the front-page collection grid.
 */
function _sacda_preprocess_featured_collections(array &$variables): void {
  if (!$variables['is_front']) {
    return;
  }

  // Include list tags even when no content is promoted, so newly promoted
  // nodes and newly added media invalidate the cached front page.
  $variables['page']['#cache']['tags'][] = 'node_list';
  $variables['page']['#cache']['tags'][] = 'media_list';
  $variables['page']['#cache']['contexts'][] = 'user.permissions';
  $variables['page']['#cache']['contexts'][] = 'user.node_grants:view';

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $ids = $storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('type', 'collection')
    ->condition('status', 1)
    ->condition('promote', 1)
    ->sort('created', 'DESC')
    ->sort('nid', 'DESC')
    ->execute();

  $variables['featured_collections'] = [];
  foreach ($storage->loadMultiple($ids) as $node) {
    $image = _sacda_front_page_image($node, $variables);
    $variables['featured_collections'][] = [
      'title' => $node->label(),
      'link' => $node->toUrl()->toString(),
      'image' => $image['url'] ?? NULL,
      'image_alt' => $image['alt'] ?? '',
    ];
  }
}

/**
 * Replaces the front-page carousel with promoted repository items.
 */
function _sacda_preprocess_repository_carousel(array &$variables): void {
  if (!$variables['is_front']) {
    return;
  }

  $variables['page']['#cache']['tags'][] = 'node_list';
  $variables['page']['#cache']['tags'][] = 'media_list';
  $variables['page']['#cache']['contexts'][] = 'user.permissions';
  $variables['page']['#cache']['contexts'][] = 'user.node_grants:view';
  // A cached page would keep the same random selection on subsequent visits.
  $variables['page']['#cache']['max-age'] = 0;
  \Drupal::service('page_cache_kill_switch')->trigger();
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $ids = $storage->getQuery()->accessCheck(TRUE)
    ->condition('type', 'islandora_object')
    ->condition('status', 1)->condition('promote', 1)
    ->sort('created', 'DESC')->sort('nid', 'DESC')->execute();
  $ids = array_values($ids);
  shuffle($ids);
  $variables['carousel_slides'] = [];
  foreach ($ids as $id) {
    $node = $storage->load($id);
    if (!$node) {
      continue;
    }
    $image = _sacda_front_page_image($node, $variables);
    if (!$image) {
      continue;
    }
    $variables['carousel_slides'][] = [
      'image_url' => $image['url'],
      'image_alt' => $image['alt'],
      'title' => $node->label(),
      'link' => $node->toUrl()->toString(),
    ];
    if (count($variables['carousel_slides']) === 10) {
      break;
    }
  }
}

/**
 * Finds accessible media attached to a repository node for a front-page card.
 */
function _sacda_front_page_image(\Drupal\node\NodeInterface $node, array &$variables): ?array {
  $variables['page']['#cache']['tags'] = array_merge($variables['page']['#cache']['tags'], $node->getCacheTags());
  $storage = \Drupal::entityTypeManager()->getStorage('media');
  $ids = $storage->getQuery()->accessCheck(TRUE)
    ->condition('field_media_of', $node->id())->condition('status', 1)
    ->sort('mid', 'DESC')->execute();
  $media_items = $storage->loadMultiple($ids);
  // Collection covers are often discovered from their descendants, rather
  // than attached directly. Use the same computed image as collection views.
  if ($node->hasField('did_image') && !$node->get('did_image')->isEmpty()) {
    $discovered = $node->get('did_image')->entity;
    if ($discovered && $discovered->isPublished()) {
      $access = $discovered->access('view', NULL, TRUE);
      \Drupal::service('renderer')->addCacheableDependency($variables['page'], $access);
      if ($access->isAllowed()) {
        $media_items = [$discovered->id() => $discovered] + $media_items;
      }
    }
  }
  // Prefer Islandora's generated thumbnail over an arbitrary attached file.
  $utils = \Drupal::service('islandora.utils');
  $term = $utils->getTermForUri('http://pcdm.org/use#ThumbnailImage');
  $thumbnail = $term ? $utils->getMediaWithTerm($node, $term) : NULL;
  if ($thumbnail && isset($media_items[$thumbnail->id()]) && empty($discovered)) {
    $media_items = [$thumbnail->id() => $media_items[$thumbnail->id()]] + $media_items;
  }
  foreach ($media_items as $media) {
    $variables['page']['#cache']['tags'] = array_merge($variables['page']['#cache']['tags'], $media->getCacheTags());
    foreach (['field_media_image', 'thumbnail'] as $field) {
      if (!$media->hasField($field) || $media->get($field)->isEmpty()) {
        continue;
      }
      $item = $media->get($field)->first();
      if ($file = $item->entity) {
        $variables['page']['#cache']['tags'] = array_merge($variables['page']['#cache']['tags'], $file->getCacheTags());
        return [
          'url' => \Drupal::service('file_url_generator')->generateString($file->getFileUri()),
          'alt' => $item->getValue()['alt'] ?? '',
        ];
      }
    }
  }
  return NULL;
}

/**
 * Supplies discovered images to taxonomy result cards.
 */
function _sacda_preprocess_taxonomy_card(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view instanceof \Drupal\views\ViewExecutable || $view->id() !== 'taxonomy_term') {
    return;
  }
  $cache = ['page' => ['#cache' => ['tags' => ['node_list', 'media_list']]]];
  $variables['taxonomy_card_image'] = _sacda_front_page_image($variables['node'], $cache);
  \Drupal::service('renderer')->addCacheableDependency($variables['elements'], \Drupal\Core\Cache\CacheableMetadata::createFromRenderArray($cache['page']));
}

/**
 * Supplies promoted exhibit cards to the front-page rotator.
 *
 * The cards are real exhibit nodes so editorial promotion controls the home
 * page. The front-page Twig template intentionally has no fallback hardcoded
 * list; an empty result means no exhibits have been promoted yet.
 */
function _sacda_preprocess_featured_exhibits(array &$variables): void {
  if (!$variables['is_front']) {
    return;
  }

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $ids = $storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('type', 'exhibit')
    ->condition('status', 1)
    ->condition('promote', 1)
    ->sort('created', 'DESC')
    ->sort('nid', 'DESC')
    ->execute();

  if (!$ids) {
    $variables['featured_exhibits'] = [];
    return;
  }

  $url_generator = \Drupal::service('file_url_generator');
  $exhibits = [];
  foreach ($storage->loadMultiple($ids) as $exhibit) {
    $image = _sacda_exhibit_thumbnail($exhibit, $url_generator);
    if (!$image) {
      continue;
    }

    $url = $exhibit->toUrl()->toString();
    if ($exhibit->hasField('field_external_url') && !$exhibit->get('field_external_url')->isEmpty()) {
      $url = $exhibit->get('field_external_url')->first()->getUrl()->toString();
    }

    $exhibits[] = [
      'title' => $exhibit->label(),
      'url' => $url,
      'image' => $image['url'],
      'image_alt' => $image['alt'] ?: $exhibit->label(),
    ];
  }

  $variables['featured_exhibits'] = $exhibits;
}

/**
 * Gets the source image and alt text from an exhibit's thumbnail media.
 */
function _sacda_exhibit_thumbnail(\Drupal\node\NodeInterface $exhibit, $url_generator): ?array {
  if (!$exhibit->hasField('field_thumbnail') || $exhibit->get('field_thumbnail')->isEmpty()) {
    return NULL;
  }

  $media = $exhibit->get('field_thumbnail')->entity;
  if (!$media) {
    return NULL;
  }

  foreach (['field_media_image', 'field_image', 'thumbnail'] as $field_name) {
    if (!$media->hasField($field_name) || $media->get($field_name)->isEmpty()) {
      continue;
    }
    $item = $media->get($field_name)->first();
    $file = $item?->entity;
    if ($file) {
      $values = $item->getValue();
      return [
        'url' => $url_generator->generateString($file->getFileUri()),
        'alt' => $values['alt'] ?? '',
      ];
    }
  }

  return NULL;
}

/**
 * Implements hook_preprocess_breadcrumb().
 *
 * Drupal's menu breadcrumb omits the current page, so the About child routes
 * otherwise stop at About. Islandora builds repository breadcrumbs from
 * field_member_of, which preserves collection ancestry but has no relationship
 * to the /collections landing page. Complete those two public hierarchies here.
 */
function sacda_preprocess_breadcrumb(array &$variables): void {
  if (empty($variables['breadcrumb'])) {
    return;
  }

  $path = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($path);

  $about_children = [
    '/about/team' => t('Team'),
    '/about/media' => t('Media'),
  ];
  if (isset($about_children[$alias])) {
    $variables['breadcrumb'][] = ['text' => $about_children[$alias]];
    return;
  }

  $node = \Drupal::routeMatch()->getParameter('node');
  if (!$node instanceof \Drupal\node\NodeInterface ||
      !str_starts_with($alias, '/collections/')) {
    return;
  }

  $has_collections = array_filter(
    $variables['breadcrumb'],
    static function (array $item): bool {
      if (!isset($item['url'])) {
        return FALSE;
      }
      $url = $item['url'] instanceof Url
        ? $item['url']->toString()
        : (string) $item['url'];
      return $url === '/collections';
    }
  );
  if (!$has_collections) {
    array_splice($variables['breadcrumb'], 1, 0, [[
      'text' => t('Collections'),
      'url' => Url::fromUserInput('/collections'),
    ]]);
  }
}

/**
 * Implements hook_preprocess_HOOK() for block templates.
 */
function sacda_preprocess_block(array &$variables): void {
  _sacda_add_color_variables($variables);

  if (isset($variables['elements']['#id'])) {
    $variables['attributes']['data-block-id'] = $variables['elements']['#id'];
  }
}

/**
 * Implements hook_preprocess_HOOK() for menu templates.
 */
function sacda_preprocess_menu(array &$variables): void {
  _sacda_add_color_variables($variables);
}

/**
 * Implements hook_preprocess_HOOK() for views_view_fields templates.
 *
 * Adds a default placeholder image for collections without cover images.
 */
function sacda_preprocess_views_view_fields(array &$variables): void {
  $view = $variables['view'];
  $view_id = $view->id();

  // List of views that need image handling
  $image_views = ['top_level_collections', 'solr_search_content'];

  if (in_array($view_id, $image_views)) {

    // Check multiple possible image field names
    $image_field_names = ['did_image', 'field_image', 'thumbnail', 'field_thumbnail', 'field_representative_image'];
    $variables['has_image'] = FALSE;
    $variables['image_field_name'] = NULL;

    foreach ($image_field_names as $field_name) {
      if (isset($variables['fields'][$field_name])) {
        $image_content = trim(strip_tags((string) $variables['fields'][$field_name]->content));
        if (!empty($image_content)) {
          $variables['has_image'] = TRUE;
          $variables['image_field_name'] = $field_name;
          break;
        }
      }
    }

    $variables['row_url'] = _sacda_views_row_url($variables);
  }
}

/**
 * Resolves the canonical URL for a views row.
 *
 * The card templates only get a clickable thumbnail when Drupal rendered a real
 * image field, because Drupal wraps that field in its own <a>. The placeholder
 * branches emit bare markup, so they need an explicit URL. The two views expose
 * it differently, hence the fallback chain.
 *
 * @return string|null
 *   The row's URL, or NULL if none could be resolved.
 */
function _sacda_views_row_url(array $variables): ?string {
  // 1. solr_search_content renders a search_api_url field for exactly this.
  if (isset($variables['fields']['search_api_url'])) {
    $url = trim(strip_tags((string) $variables['fields']['search_api_url']->content));
    if ($url !== '') {
      return $url;
    }
  }

  // 2. Derive from the row object. top_level_collections rows carry the node;
  // search_api rows carry the indexed item, whose value is the entity.
  $row = $variables['row'] ?? NULL;
  $entity = $row->_entity ?? NULL;
  if (!$entity && isset($row->_object) && method_exists($row->_object, 'getValue')) {
    $entity = $row->_object->getValue();
  }
  if ($entity instanceof \Drupal\Core\Entity\EntityInterface && $entity->hasLinkTemplate('canonical')) {
    return $entity->toUrl()->toString();
  }

  // 3. Last resort: the title field is already a link in both views.
  $title = (string) ($variables['fields']['title']->content ?? '');
  if ($title !== '' && preg_match('/href="([^"]+)"/', $title, $matches)) {
    return \Drupal\Component\Utility\Html::decodeEntities($matches[1]);
  }

  return NULL;
}

function sacda_preprocess_region(&$variables) {
  if ($variables['region'] === 'content') {
    $route_match = \Drupal::routeMatch();
    $variables['route_name'] = $route_match->getRouteName();

    // Expose the node bundle on node pages so the content region can choose the
    // right width (only islandora_object needs the wide two-column layout).
    $node = $route_match->getParameter('node');
    if ($node instanceof \Drupal\node\NodeInterface) {
      $variables['node_bundle'] = $node->bundle();
    }

    // The About page templates set their own container width (max-w-7xl) around
    // {{ page.content }}, so the region must not re-cap it at max-w-5xl — that
    // squeezed the team/media grids well inside the band widths around them.
    $path = \Drupal::service('path.current')->getPath();
    $alias = \Drupal::service('path_alias.manager')->getAliasByPath($path);
    $variables['self_widthed_content'] = str_starts_with($alias, '/about') || $variables['route_name'] === 'view.taxonomy_term.page_1';
  }

  // "Clear all" for the facet sidebar: the current page without any facet
  // filters (f[]) or pager, keeping the search terms.
  if ($variables['region'] === 'filters') {
    $variables['#cache']['contexts'][] = 'url.query_args';
    $query = \Drupal::request()->query->all();
    if (!empty($query['f'])) {
      unset($query['f'], $query['page']);
      $variables['clear_filters_url'] = \Drupal\Core\Url::fromRoute('<current>', [], ['query' => $query])->toString();
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function sacda_form_advanced_search_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Attach the advanced search JavaScript library
  $form['#attached']['library'][] = 'sacda/advanced-search';

  // 1. Make the parent 'terms' container our CSS Grid wrapper
  $form['ajax']['terms']['#attributes']['class'][] = 'advanced-search-grid';

  // 2. Loop over the flat terms and wrap each field in a div with grid column class
  if (isset($form['ajax']['terms'])) {
    foreach (Element::children($form['ajax']['terms']) as $key) {

      if (isset($form['ajax']['terms'][$key]['conjunction'])) {
        $form['ajax']['terms'][$key]['conjunction']['#prefix'] = '<div class="grid-col-conjunction">';
        $form['ajax']['terms'][$key]['conjunction']['#suffix'] = '</div>';
      }

      if (isset($form['ajax']['terms'][$key]['search'])) {
        $form['ajax']['terms'][$key]['search']['#prefix'] = '<div class="grid-col-search">';
        $form['ajax']['terms'][$key]['search']['#suffix'] = '</div>';
      }

      if (isset($form['ajax']['terms'][$key]['include'])) {
        $form['ajax']['terms'][$key]['include']['#prefix'] = '<div class="grid-col-include">';
        $form['ajax']['terms'][$key]['include']['#suffix'] = '</div>';
      }

      if (isset($form['ajax']['terms'][$key]['value'])) {
        $form['ajax']['terms'][$key]['value']['#prefix'] = '<div class="grid-col-value">';
        $form['ajax']['terms'][$key]['value']['#suffix'] = '</div>';
      }

      if (isset($form['ajax']['terms'][$key]['actions'])) {
        $form['ajax']['terms'][$key]['actions']['#prefix'] = '<div class="grid-col-actions">';
        $form['ajax']['terms'][$key]['actions']['#suffix'] = '</div>';
      }
    }
  }

  // 3. Group the main submit/reset buttons
  $form['actions_wrapper'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['advanced-search-actions']],
    '#weight' => 99,
  ];
  if (isset($form['submit'])) {
    $form['actions_wrapper']['submit'] = $form['submit'];
    unset($form['submit']);
  }
  if (isset($form['reset'])) {
    $form['actions_wrapper']['reset'] = $form['reset'];
    unset($form['reset']);
  }
}

/**
 * Implements hook_preprocess_HOOK() for mirador.html.twig.
 *
 * islandora_mirador ships Mirador configured like the full multi-window IIIF
 * workbench. For a single-object digital archive most of that chrome is dead
 * weight, so we trim the final viewer config (already assembled by the module's
 * template_preprocess_mirador(), which runs first) down to a focused reader:
 * one object, page navigation, and OCR search — no workspace/window management.
 */
function sacda_preprocess_mirador(array &$variables): void {
  $id = $variables['mirador_view_id'] ?? NULL;
  if (!$id) {
    return;
  }
  $key = '#' . $id;
  if (empty($variables['#attached']['drupalSettings']['mirador']['viewers'][$key])) {
    return;
  }
  $viewer = &$variables['#attached']['drupalSettings']['mirador']['viewers'][$key];

  // Drop the left workspace control panel (add-window / workspace switcher) —
  // this site never shows more than one object at a time.
  $viewer['workspaceControlPanel'] = ['enabled' => FALSE];
  $viewer['workspace'] = ($viewer['workspace'] ?? []) + [
    'showZoomControls' => TRUE,
    'allowNewWindows' => FALSE,
  ];

  // Simplify the window chrome. The top bar is hidden in css/_mirador.css;
  // the sidebar is opened from js/mirador-controls.ts instead.
  $viewer['window'] = ($viewer['window'] ?? []) + [
    'allowClose' => FALSE,
    'allowMaximize' => FALSE,
    'allowTopMenuButton' => FALSE,
    'allowWindowSideBar' => TRUE,
    'sideBarOpenByDefault' => FALSE,
    'defaultSideBarPanel' => 'info',
    'panels' => [
      'info' => TRUE,
      'attribution' => TRUE,
      'canvas' => TRUE,
      'annotations' => FALSE,
      'search' => TRUE,
      'layers' => FALSE,
    ],
  ];

  // Page thumbnails as a vertical strip on the right rather than a band
  // under the image, which ate a large share of the viewer's height. The
  // module pins far-bottom on each window, so override it there.
  foreach ($viewer['windows'] ?? [] as $i => $window) {
    $viewer['windows'][$i]['thumbnailNavigationPosition'] = 'far-right';
  }
}
