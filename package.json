{
    "name": "sacda",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently \"bun scripts/build.ts --watch\" \"bun run livereload\"",
        "build": "bun scripts/build.ts && bun scripts/build-viewers.ts && bun run update-libraries",
        "update-libraries": "bun scripts/update-libraries.ts",
        "livereload": "livereload --exclusions node_modules/,dist/ --exts 'css,js,twig,theme,apng,avif,gif,jpg,jpeg,jfif,pjpeg,pjp,png,svg,webp'",
        "prepare": "simple-git-hooks"
    },
    "simple-git-hooks": {
        "post-merge": "bun install && bun run build"
    },
    "devDependencies": {
        "@types/node": "^25.0.3",
        "concurrently": "^9.1.0",
        "livereload": "^0.9.3",
        "simple-git-hooks": "^2.13.1",
        "tailwindcss": "^4.1.18",
        "tw-animate-css": "^1.4.0"
    },
    "dependencies": {
        "@samvera/ramp": "5.1.1",
        "@tailwindcss/cli": "^4.1.18",
        "embla-carousel": "^8.6.0",
        "embla-carousel-autoplay": "^8.6.0",
        "glob": "^13.0.0",
        "gsap": "^3.14.2",
        "mirador": "4.2.3",
        "mirador-textoverlay": "1.1.1",
        "react": "19",
        "react-dom": "19"
    }
}
